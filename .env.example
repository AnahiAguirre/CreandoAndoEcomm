# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# NOTHING here should be prefixed NEXT_PUBLIC_: it would ship to the browser bundle.

# --- Supabase (Project Settings > Database > Connection string) ---
# App runtime: transaction pooler (Supavisor), port 6543. Add ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations only (drizzle-kit): direct connection, port 5432.
DATABASE_URL_DIRECT="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres"

# --- Supabase (Project Settings > API) — used only server-side for Storage ---
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Public on purpose: the browser needs these to PUT files straight to Storage
# using the signed upload URL/token the server hands it (see lib/supabase-browser.ts).
# The anon key alone grants nothing without a valid signed token.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32+char-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Mercado Pago (Developers > Your integrations > Credentials) ---
# Use TEST credentials (TEST-...) until fase 9 (Producción).
MP_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Set in the same panel under Webhooks > Secret key.
MP_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Resend ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be an address on a domain verified in Resend.
MAIL_FROM="tienda@tudominio.com"
