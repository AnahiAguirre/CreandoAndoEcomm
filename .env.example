# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# Only the NEXT_PUBLIC_* lines reach the browser bundle. Everything else is server-only.

# ============ Fase 1 ============

# --- Supabase → Connect → ORMs → Drizzle ---
# App runtime: transaction pooler (Supavisor), port 6543, with ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations / scripts only (drizzle-kit, seed, promote-admin): session mode, port 5432.
DATABASE_URL_DIRECT="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase → Project Settings → Data API ---
SUPABASE_URL="https://xxxx.supabase.co"

# ============ Fase 2 ============

# --- Supabase → Project Settings → API Keys ---
# Secret key (sb_secret_...) or legacy service_role key. Bypasses Storage policies. SERVER ONLY.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"
# Publishable key (sb_publishable_...) or legacy anon key. Public on purpose: the
# browser uses it to PUT files to Storage with a signed token the server issued.
# Alone it grants nothing.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Better Auth ---
# Generate with: openssl rand -base64 32   (or any 32+ char random string)
BETTER_AUTH_SECRET="replace-with-32+char-random-string"
# Optional. On Vercel it is derived from the deployment URL; set it explicitly
# once there's a custom domain, so the Google callback points at the real address.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google sign-in → console.cloud.google.com → APIs y servicios → Credenciales ---
# "ID de cliente de OAuth" de tipo "Aplicación web". URI de redireccionamiento autorizado:
#   http://localhost:3000/api/auth/callback/google  (y la de producción, con su dominio)
# Optional until configured: without them only admins can sign in (/ingresar/admin).
GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Resend (optional in dev: without it, mails are printed to the server console) ---
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be an address on a domain verified in Resend.
# MAIL_FROM="CreandoAndo <hola@tudominio.com>"
# Without a domain yet (test mode): Resend's own sender works, but ONLY delivers
# to the email the Resend account was created with — fine for the admin, not for customers.
# MAIL_FROM="CreandoAndo <onboarding@resend.dev>"

# ============ Fase 3 (todavía no) ============

# --- Mercado Pago → Tus integraciones → Credenciales de prueba ---
# MP_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# MP_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
